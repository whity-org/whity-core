{
  "name": "whity-tauri-desktop-template",
  "private": true,
  "version": "0.2.0",
  "description": "Boilerplate Tauri v2 desktop app consuming @whity/ui + @whity/features. Start here, then add crates for native capabilities (see src-tauri/src/commands/printer.rs for a worked example).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-sdk.mjs && vite",
    "build": "node scripts/copy-sdk.mjs && tsc && vite build",
    "copy-sdk": "node scripts/copy-sdk.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@whity/features": "file:../../packages/features",
    "@whity/tokens": "file:../../packages/tokens",
    "@whity/ui": "file:../../packages/ui",
    "@hookform/resolvers": "^7.0.6",
    "@tabler/icons-react": "^3.52.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "katex": "^0.19.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.8"
  }
}

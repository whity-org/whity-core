{
  "name": "@whity/api-client",
  "version": "0.2.0",
  "description": "Typed client for the Whity API, generated from its OpenAPI spec.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/whity-org/whity-core.git",
    "directory": "packages/api-client"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../public/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\""
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}

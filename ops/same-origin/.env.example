# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
ORIGIN=http://localhost:8080
PUBLISH=8080
SITE_ADDRESS=:8080

DB_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=
WHITY_CLIENT_IP_SECRET=

INITIAL_SYSTEM_ADMIN_EMAIL=
INITIAL_SYSTEM_ADMIN_PASSWORD=
INITIAL_ADMIN_PASSWORD=
INITIAL_USER_PASSWORD=
INITIAL_SUPERUSER_PASSWORD=

# Optional (#2386)
WHITY_HIDDEN_NAV_IDS=
WHITY_HOME_PATH=
WHITY_BACK_TO_PRODUCT_URL=/
WHITY_BACK_TO_PRODUCT_LABEL=Back to Example Bakery
WHITY_PWA_SCOPE=/

# The network Caddy and the apps share, and Caddy's fixed address in it.
EDGE_SUBNET=172.30.0.0/24
CADDY_IP=172.30.0.10
# The database's own network.
INTERNAL_SUBNET=172.31.0.0/24
